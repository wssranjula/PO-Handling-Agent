APP_ENV=development
DATABASE_URL=postgresql+asyncpg://po_agent:po_agent@localhost:5432/po_agent
ATTACHMENT_DIR=data/attachments
MAX_ATTACHMENT_BYTES=10485760
AUTO_CREATE_SCHEMA=true
EXTRACTION_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=90
MIN_EXTRACTION_CONFIDENCE=0.85
MAX_DOCUMENT_CHARACTERS=150000
LOG_LEVEL=INFO
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=po-intake-agent
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=secrets/gmail-credentials.json
GMAIL_TOKEN_PATH=secrets/gmail-token.json
GMAIL_POLL_INTERVAL_SECONDS=30
GMAIL_QUERY="is:unread has:attachment newer_than:7d"
GMAIL_MAX_MESSAGES_PER_POLL=25
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=4
RAG_MATCH_THRESHOLD=0.70
PRICE_TOLERANCE_PERCENT=1.0
